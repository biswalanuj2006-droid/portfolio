# ------------------------------------------------------------------
# Anuj Biswal Portfolio - environment configuration
# Copy this file to `.env` and adjust the values.
# NEVER commit the real `.env` file.
# ------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma separated hosts (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated HTTPS origins, e.g. https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# Initial admin account (used by: python manage.py seed_data)
# Also synced automatically when the admin login page is opened (see apps/core/startup.py)
ADMIN_USERNAME=Anuj-2006
ADMIN_PASSWORD=Anuj@2006
ADMIN_EMAIL=biswalanuj2006@gmail.com

# Optional: switch from SQLite to PostgreSQL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=portfolio
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
